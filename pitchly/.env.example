# -----------------------------------------------------------------------------
# Pitchly Environment Configuration
# Copy this file to .env and fill in your values
# -----------------------------------------------------------------------------

# Nebius Token Factory / OpenAI-compatible endpoint configuration
# Obtain your key from Nebius Studio (https://studio.nebius.ai/)
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_API_KEY=your-nebius-token-factory-api-key-here

# AI Model Selection (NVIDIA / open-weights models served via Nebius)
# Confirm exact model IDs in the Nebius Token Factory catalog:
# - FAST_MODEL: Lightweight, low-latency model for rapid decomposition and task cards
FAST_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# - REASONING_MODEL: High-capacity reasoning model for architectural tradeoff, risk analysis, and "why" inquiries
REASONING_MODEL=deepseek-ai/DeepSeek-R1-Distill-Llama-70B

# Django Backend Configuration
DEBUG=True
SECRET_KEY=django-insecure-pitchly-hackathon-secret-key-change-in-prod
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
# Leave blank to use local SQLite (default for quick demo), or set for Postgres:
# DATABASE_URL=postgres://pitchly:pitchly_pass@postgres:5432/pitchly_db
DATABASE_URL=

# Channel Layer Configuration
# Leave blank to use InMemoryChannelLayer (great for local demo without Redis), or set Redis URL:
# REDIS_URL=redis://redis:6379/0
REDIS_URL=

# Frontend Configuration (for Vite)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
